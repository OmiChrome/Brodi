# Copy to .env.local. Existing environment variables win over these values.
# YAML alternative: copy config.example.yaml to brodi.yaml (lowest precedence).
OPENAI_API_KEY=

# Explicit model defaults. Do not substitute models silently.
BRODI_DECISIONS_MODEL=gpt-6-luna
BRODI_CODEGEN_MODEL=gpt-6-luna
BRODI_REASONING_EFFORT=none
BRODI_FAST_MODEL=gpt-6-luna
BRODI_FAST_FALLBACK_MODEL=gpt-6-luna
BRODI_PLANNER_MODEL=gpt-6-luna
# BRODI_TTS_MODEL=gpt-4o-mini-tts
# BRODI_VOICE=onyx
BRODI_TTS_SPEED=1.25
# BRODI_TTS_INSTRUCTIONS=Speak English in a natural, warm male voice with clear, relaxed delivery.
BRODI_TTS_ENABLED=true
# Windows launcher shows tray controls; false disables automatic tray.
BRODI_TRAY=true

BRODI_WAKE_WINDOW_S=20

BRODI_ENABLE_MULTI_STEP=true
BRODI_MAX_STEPS=5
BRODI_STEP_TIMEOUT_MS=8000
BRODI_PLAN_TIMEOUT_S=40
BRODI_FAST_LAUNCH=true

BRODI_MEMORY_ENABLED=true
BRODI_MEMORY_RETENTION_DAYS=30
BRODI_MEMORY_MAX_ENTRIES=500
# BRODI_MEMORY_PATH=              # defaults to user data/Brodi/memory.sqlite3
# BRODI_DATA_DIR=                 # override user data directory
# BRODI_CONFIG=                   # explicit YAML file

BRODI_LEARN=1
BRODI_POLICY=strict
# BRODI_OS=win32                  # or darwin; defaults to host OS
# BRODI_CODEGEN_ATTEMPTS=3
# BRODI_CODEGEN_MAX_TOKENS=1500
# BRODI_VERIFY_THRESHOLD=0.4

# Chrome profile and CDP. Opening a URL does not require CDP; page interaction does.
# BRODI_CHROME_PROFILE_EMAIL=you@example.com
# BRODI_CHROME_PROFILE_DIR=Profile 1
# BRODI_CHROME_HOME=
# BRODI_CDP_URL=http://127.0.0.1:9222
# BRODI_BROWSER_BUDGET_S=90
# BRODI_BROWSER_MAX_STEPS=25
# BRODI_ACTIVITY_LOG=             # default .freebuff/activity.jsonl
# BRODI_LOG=                      # technical launcher log

# Only for legacy deployed LiveKit workers, not local wake console.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# English-only command voice. Replies are at most two words; details stay in activity.
BRODI_VOICE_MODE=pipeline
BRODI_STT_MODEL=gpt-live-transcribe
BRODI_STT_SILENCE_MS=250
# BRODI_STT_RMS_THRESHOLD=160     # audio-boundary sensitivity; recognition stays in the cloud
# For missed headset commands or turns held open by noise, see docs/WAKE.md
# and config.macbook.example.yaml for the tested cloud-boundary/MacBook mic setup.
# Recognition is fixed to English. Legacy language overrides are ignored.
# BRODI_STT_KEYWORDS=Brodi,Chrome,Notepad,GitHub,YouTube,Google Keep,Slack
BRODI_WAKE_REQUIRED=false
# `brodi wake enable` (Windows) / `./brody wake enable` (macOS) enables login startup.
# Background mode forces wake-required cloud listening and suppresses the startup greeting.
# BRODI_STARTUP_GREETING=true     # foreground/manual starts only
