# The only required secret: one OpenAI key drives voice, decisions, codegen and the browser.
OPENAI_API_KEY=

# Optional: models (defaults shown). BRODI_DECISIONS_MODEL powers routing/judgments
# (gpt-6-luna is the only model the Decisions API accepts, and it generates no text).
# BRODI_DECISIONS_MODEL=gpt-6-luna
# BRODI_CODEGEN_MODEL=gpt-6.1-sol
# BRODI_FAST_MODEL=gpt-5.4-nano
# BRODI_FAST_FALLBACK_MODEL=gpt-5.4-nano
# BRODI_CHAT_MODEL=gpt-5.4-nano
# BRODI_STT_MODEL=gpt-4o-mini-transcribe-2025-12-15
# BRODI_TTS_MODEL=gpt-4o-mini-tts
# BRODI_REALTIME_MODEL=gpt-realtime-2.1-mini
# BRODI_VOICE=onyx
# BRODI_VOICE_MODE=pipeline          # or "realtime"
# BRODI_LANG=en
# BRODI_REASONING_EFFORT=low         # codegen reasoning effort ("minimal" is cheapest)

# Platform override (defaults to the host OS): "darwin" or "win32".
# BRODI_OS=win32

# Tool learning and policy.
# BRODI_LEARN=1                      # set 0 to disable the codegen fallback
# BRODI_POLICY=strict                # "off" disables the safety policy (debugging only)

# Chrome: pin every launch to the profile signed in as this email.
# BRODI_CHROME_PROFILE_EMAIL=you@example.com   # unset: Chrome's last-used profile
# BRODI_CHROME_PROFILE_DIR=Profile 1           # override by directory name instead
# BRODI_CHROME_HOME=                           # URL for "open Chrome"; empty = new-tab page

# Browser tasks: Chrome must allow remote debugging at chrome://inspect/#remote-debugging.
# BRODI_CDP_URL=http://127.0.0.1:9222
# BRODI_BROWSER_BUDGET_S=90
# BRODI_BROWSER_MAX_STEPS=25

# LiveKit Cloud — only needed for `agent.py dev` / deployed workers, not local `console`.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cheap testing: no-thinking codegen model instead of gpt-6.1-sol.
# BRODI_CODEGEN_MODEL=gpt-5-nano
# BRODI_REASONING_EFFORT=minimal
