#!/bin/zsh
# macOS controls, shared with the background service and Windows tray.
set -u
ROOT=${0:A:h}
cd "$ROOT" || exit 1
export BRODI_LOG=${BRODI_LOG:-${TMPDIR:-/tmp/}brody-${UID}.log}

brodi_python() {
  if [[ -x "$ROOT/.venv/bin/python" ]]; then
    "$ROOT/.venv/bin/python" "$@"
  else
    uv run python "$@"
  fi
}

case ${1:-status} in
  wake)
    case ${2:-status} in
      enable|disable|status) brodi_python -m brodi.background "${2:-status}" ;;
      *) print -u2 'usage: ./brody wake enable|disable|status'; exit 2 ;;
    esac ;;
  start|stop|restart|status) brodi_python -m brodi.background "${1:-status}" ;;
  log|debug)
    [[ -f $BRODI_LOG ]] && tail -n 100 "$BRODI_LOG" || { print -u2 "no log at $BRODI_LOG"; exit 1; } ;;
  *) print -u2 'usage: ./brody start|stop|status|restart|log|wake [enable|disable|status]'; exit 2 ;;
esac
